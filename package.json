{
  "name": "jsray-terminal",
  "version": "0.0.1-internal.1",
  "private": true,
  "description": "JSRay code rendering for the terminal: ANSI syntax highlighting powered by the JSRay Core tokenizer and palettes.",
  "author": "Eric Liu <eric@jsray.org>",
  "license": "MIT",
  "homepage": "https://jsray.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSRayCore/jsray-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/JSRayCore/jsray-terminal/issues"
  },
  "type": "module",
  "bin": {
    "jsray": "./bin/jsray.mjs"
  },
  "scripts": {
    "sync:core": "sh tools/sync-core.sh",
    "check:versions": "node tools/check-versions.mjs",
    "test": "node --test tests/*.mjs"
  },
  "keywords": [
    "jsray",
    "syntax-highlighting",
    "terminal",
    "ansi",
    "cli",
    "code-rendering"
